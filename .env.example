# Copy to frontend/.env.local, then restart Next.js.
# Local frontend + local backend:
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Local frontend + Render, or Vercel + Render: replace the value above with
# https://demo-jpuo.onrender.com/api/v1. Rebuild/redeploy Vercel after changes.
# This is public routing configuration, never a database URL or secret.

# Optional same-origin proxy: blank NEXT_PUBLIC_API_BASE_URL and set the backend
# origin here (no /api/v1 suffix). Both settings are consumed at build time.
API_PROXY_TARGET=

# Optional legacy LAN server picker; disabled by default. Explicit API_BASE_URL wins.
NEXT_PUBLIC_ALLOW_API_OVERRIDE=false
